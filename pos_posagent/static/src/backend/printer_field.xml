<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pos_posagent.POSAgentPrinterField">
        <t t-if="props.readonly">
            <span t-esc="value"/>
        </t>
        <t t-else="">
            <div class="d-flex align-items-center gap-1 flex-wrap">
                <select
                    class="o_input flex-grow-1"
                    t-att-value="value"
                    t-att-disabled="state.loading"
                    t-on-change="onChange"
                >
                    <option value="" t-esc="emptyLabel"/>
                    <t t-foreach="printers" t-as="printer" t-key="printer.name">
                        <option t-att-value="printer.name" t-att-selected="printer.name === value">
                            <t t-esc="printer.name"/>
                            <t t-if="!printer.ready"> — <t t-esc="'Not ready'"/></t>
                        </option>
                    </t>
                </select>
                <button
                    type="button"
                    class="btn btn-outline-secondary btn-sm"
                    title="Refresh printers"
                    t-att-disabled="state.loading"
                    t-on-click="refreshPrinters"
                >↻</button>
                <button
                    type="button"
                    class="btn btn-outline-primary btn-sm"
                    t-att-disabled="state.loading || !value"
                    t-on-click="testPrinter"
                >Test</button>
            </div>
            <small t-if="state.error" class="text-danger d-block mt-1" t-esc="state.error"/>
            <small t-if="state.message" class="text-success d-block mt-1" t-esc="state.message"/>
        </t>
    </t>
</templates>
